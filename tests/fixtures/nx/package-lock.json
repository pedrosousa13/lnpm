{
  "name": "nx-workspace-test",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "nx-workspace-test",
      "version": "1.0.0",
      "workspaces": [
        "libs/**"
      ]
    },
    "libs/feature-auth": {
      "name": "@nx-test/feature-auth",
      "version": "1.0.0",
      "dependencies": {
        "@npm-test/package-a": "file:.lnpm/@npm-test/package-a"
      }
    },
    "libs/feature-auth/.lnpm/@npm-test/package-a": {
      "version": "1.0.0"
    },
    "libs/feature-auth/node_modules/@npm-test/package-a": {
      "resolved": "libs/feature-auth/.lnpm/@npm-test/package-a",
      "link": true
    },
    "node_modules/@nx-test/feature-auth": {
      "resolved": "libs/feature-auth",
      "link": true
    }
  }
}
